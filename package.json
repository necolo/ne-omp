{
  "name": "ne-omp",
  "version": "0.1.0",
  "private": true,
  "description": "Necolo's extensions for oh-my-pi (omp).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "extensions/**/*.ts",
    "extensions/**/*.js"
  ],
  "omp": {
    "features": {
      "theme": {
        "description": "Interactive theme picker with live preview",
        "default": false,
        "extensions": ["extensions/theme/index.ts"]
      },
      "project": {
        "description": "Quickly switch between projects and start a fresh session",
        "default": false,
        "extensions": ["extensions/project/index.ts"]
      },
      "tree-delete": {
        "description": "Session tree with confirmed subtree deletion and journal backups",
        "default": false,
        "extensions": ["extensions/tree-delete/index.ts"]
      }
    }
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "1.2.0",
    "@oh-my-pi/pi-ai": "18.10.0",
    "@oh-my-pi/pi-coding-agent": "18.10.0",
    "@oh-my-pi/pi-tui": "18.10.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
